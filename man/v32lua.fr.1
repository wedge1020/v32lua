.TH V32LUA 1 "octobre 2026" "v32lua 20261021-dev" "Commandes utilisateur"
.SH NOM
v32lua \- compile un sous-ensemble de Lua en assembleur Vircon32 et en XML de cartouche
.SH SYNOPSIS
.B v32lua
.RB [ \-o
.IR sortie.asm ]
.RB [ \-b ]
.RB [ \-g ]
.RB [ \-v ]
.RB [ \-d ]
.RB [ \-w ]
.RB [ \-\-api
.IR api ]
.RB [ \-\-title
.IR titre ]
.RB [ \-\-titleopt
